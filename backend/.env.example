# Live speech-to-text (https://console.deepgram.com). Without it, voice is
# disabled and the app offers typing only.
DEEPGRAM_API_KEY=
# standard = the original Deepgram request (default). enhanced = opt-in nova-3/nova-2,
# interim results, sentence grouping and voice auto-detect (language=multi).
DEEPGRAM_MODE=standard

# Gemini translation + summaries (https://aistudio.google.com/apikey, free tier).
# Without it, translation falls back to the Google/MyMemory/Libre path.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is overloaded, rate-limited, slow or not served on this key.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash
# Thinking depth for Gemini 3 models: LOW (fastest supported by 3.8 Flash), MEDIUM, HIGH, or OFF to send none.
GEMINI_THINKING_LEVEL=LOW
GEMINI_TIMEOUT_MS=7000
GEMINI_SUMMARY_TIMEOUT_MS=20000
GEMINI_ALTERNATIVES_TIMEOUT_MS=9000
# Pause before the one retry round when every model is busy (429/503).
GEMINI_RETRY_PAUSE_MS=600
# Earlier lines sent as context with each translation.
TRANSLATION_CONTEXT_TURNS=3

# Free-tier protection (per client IP unless noted)
AI_TRANSLATE_PER_MIN=20
AI_TRANSLATE_PER_DAY=300
AI_SUMMARY_PER_HOUR=6
AI_GLOBAL_PER_MIN=30
AI_DAILY_CAP=1000
TRANSLATE_PER_MIN=40
MAX_SESSION_MINUTES=10
MAX_SOCKETS_PER_IP=3

# Optional
# ALLOWED_ORIGINS=https://live-translator-app.onrender.com
# LIBRETRANSLATE_URL=https://libretranslate.com
# LIBRETRANSLATE_API_KEY=
# TRUST_PROXY=1   (defaults to 1 on Render)
